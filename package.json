{
  "name": "dsh-think-tools",
  "version": "0.4.2",
  "description": "DSH 思考与工具调用聚合：回合级思考 chip（实时时长/实时文字滚动）+ 工具调用聚合 chip + 共享活动抽屉 + 对话流卡片（步骤卡/总结卡，回合结束后才出现）+ 对话截图（assistant 消息相机按钮，无头浏览器渲染成图）——自 dsh-webui 移植。零 DSH 源码改动。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "tool-summary",
    "activity-drawer",
    "flow-card",
    "screenshot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statem-li/dsh-think-tools.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "scripts",
    "build.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-client.mjs && node scripts/smoke-host.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke-host.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "markdown-it": "^15.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.4.3"
  }
}
